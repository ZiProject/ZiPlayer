# Copy to ".env" and fill in. Real environment variables override this file.
# Use another file with: node test-cluster.js --env=./staging.env

# ── Discord (only the bot node uses it) ─────────────────────────────────────
DISCORD_TOKEN=
COMMAND_PREFIX=!
# Optional allow-lists (comma separated). Empty = anyone / any guild.
ALLOWED_GUILD_ID=
ALLOWED_USER_IDS=

# ── MQTT (Mosquitto) ────────────────────────────────────────────────────────
MQTT_URL=mqtt://127.0.0.1:1883
# "{node}" is replaced by the node id, so every node can log in as itself (pairs with mosquitto.acl.example).
MQTT_USERNAME={node}
MQTT_PASSWORD=
# 5 (default) or 4 for brokers without MQTT v5
MQTT_PROTOCOL=5

# ── Cluster ─────────────────────────────────────────────────────────────────
NET_ID=ziplayer-test
# id:plugin+plugin, ... The Discord bot node is DISCORD_NODE (default: the first one).
# Plugin names: youtube, soundcloud, spotify, tts, attachments. Give nodes DIFFERENT plugins to force relay/handoff.
NODES=bot-1:soundcloud,yt-1:youtube,tts-1:tts+attachments
DISCORD_NODE=
# Let the bot node serve streams to the others too (0/1)
BOT_SERVES=0
# Where node keys live (<id>.key private, <id>.key.pub public). Copy only the .pub files between machines.
KEY_DIR=./.keys
ENCRYPT_AUDIO=0

# ── Test behaviour ──────────────────────────────────────────────────────────
# Search text for youtube / soundcloud / spotify when the command or selftest needs a track
TEST_QUERY=lofi hip hop
# Share of tracks the bot cannot resolve at or above which routeTracks() hands the voice off
HANDOFF_THRESHOLD=0.5
# Lets "!kill <node>" make a node crash (SIGKILL) to test failover. Never enable this outside tests.
ALLOW_REMOTE_KILL=0
DEBUG=0
